# Generate once and keep stable. Losing this key makes persisted sessions unreadable.
LILLYGRAM_ENCRYPTION_KEY=
LILLYGRAM_DATABASE_PATH=data/lillygram.sqlite3

# Optional comma-separated origins for browser-based admin tooling. Native iOS does not use CORS.
LILLYGRAM_ALLOWED_ORIGINS=

# Conservative per-account hard ceilings.
LILLYGRAM_READ_LIMIT_PER_HOUR=120
LILLYGRAM_WRITE_LIMIT_PER_HOUR=6
LILLYGRAM_LOGIN_LIMIT_PER_HOUR=3
LILLYGRAM_WARMUP_DAYS=3
